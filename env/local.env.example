PORT=8080
LOG_FORMAT=text
CHECK_INTERVAL="30s"
STATE_PATH="/tmp/state.json"

# Optional comma-separated list of webhook callback URLs called on IP address change
WEBHOOK_URLS="your_callback,urls_here,comma_separated_list"

# Optional email notification on IP address change (all values below are required to enable it).
# For iCloud, EMAIL_USERNAME is your full iCloud address and EMAIL_PASSWORD is an app-specific
# password from https://account.apple.com. EMAIL_PERSONAL_EMAIL is used as both sender and recipient.
# In Kubernetes, provide these through a SealedSecret instead (see README).
# EMAIL_HOST_NAME="smtp.mail.me.com"
# EMAIL_PORT=587
# EMAIL_TLS=true
# EMAIL_USERNAME="you@icloud.com"
# EMAIL_PASSWORD="xxxx-xxxx-xxxx-xxxx"
# EMAIL_PERSONAL_EMAIL="you@icloud.com"
