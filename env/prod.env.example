PORT=8080
LOG_FORMAT=text
CHECK_INTERVAL="30s"
STATE_PATH="/tmp/state.json"

# SMTP settings. EMAIL_PASSWORD must be the SMTP password for EMAIL_USERNAME.
EMAIL_HOST_NAME=smtp.example.com
EMAIL_PASSWORD=replace-me
EMAIL_PERSONAL_EMAIL=you@example.com
EMAIL_PORT=587
EMAIL_TLS=true
EMAIL_USERNAME=sender@example.com
